{
	"schema_version": 1,
	"quilt_loader": {
		"group": "${group}",
		"id": "commonside",
		"version": "${version}",
		"metadata": {
			"name": "Commonside Models Library",
			"description": "A lightweight framework that allows interacting with custom entity models.",
			"contributors": {
				"Ubunifu": "Owner"
			},
			"contact": {
				"homepage": "https://example.com/",
				"issues": "https://github.com/QuiltMC/quilt-template-mod/issues",
				"sources": "https://github.com/QuiltMC/quilt-template-mod"
			},
			"icon": "assets/commonside/icon.png"
		},
		"intermediate_mappings": "net.fabricmc:intermediary",
		"entrypoints": {
			"init": "com.ubunifu.commonside.CommonsideMod"
		},
		"depends": [
			{
				"id": "quilt_loader",
				"versions": ">=0.19.1"
			},
			{
				"id": "quilted_fabric_api",
				"versions": ">=7.0.2"
			},
			{
				"id": "minecraft",
				"versions": ">=1.20"
			}
		]
	},
	"mixin": "commonside.mixins.json"
}
